{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Agent CLIs installed with npm install -g <package>@<version> in any agent's Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["npm install -g (?<depName>@?[^@\\s]+)@(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "npm"
    }
  ]
}
